---
import { actions } from "astro:actions";
import Layout from "../layouts/Layout.astro";

const test = () => {
	const t2 = "";
};

const login = await Astro.session?.get("login");
console.log(login);
---

<Layout>
	<h1>Astro</h1>
	<div>
		<section class="test">
			<h1>test</h1>
		</section>
		<form
			action={actions.login}
			method="POST">
			<input
				type="email"
				name="email"
				class="border border-amber-400" />
			<input
				type="password"
				name="password"
				class="border border-amber-400" />
			<button type="submit">Login</button>
		</form>
		{login}
	</div>
</Layout>

<script>
const form = document.forms[0];
form.addEventListener("submit", (e) => {
	e.preventDefault();
	console.log(form);
	fetch(form.action, {
		method: form.method,
		body: new FormData(form),
	});
});
</script>
