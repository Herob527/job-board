---
import Layout from "#/layouts/Layout.astro";
import z from "zod";

const { jobOfferService } = Astro.locals;

const paramsSchema = z.object({
  page: z.coerce.number().nonnegative().default(0),
  pageSize: z.coerce.number().nonnegative().default(10),
});

const { data, error } = paramsSchema.safeParse(Astro.url.searchParams);
if (error) {
  console.error(error);
  throw error;
}

const { page, pageSize } = data;
const jobOffers = await jobOfferService.getJobOffersPaginated(page, pageSize);
const isEmpty = jobOffers.length === 0;
---

<Layout>
  <h1>Job offers</h1>
  <div>
    <section class="test">
      {isEmpty && <span>Nothing there yet</span>}
      <div class="flex flex-col">
        {jobOffers.map((it) => <div>{it.JobOffer.title}</div>)}
      </div>
    </section>
  </div>
</Layout>
