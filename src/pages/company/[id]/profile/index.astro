---
import Layout from "#/layouts/Layout.astro";
const { id } = Astro.params;
if (!id) {
  throw new Error("ID not supplied");
}
const { companyService } = Astro.locals;
const data = await companyService.getCompanyById(id);
if (!data) {
  throw new Error("Company not found");
}
---

<Layout>
  <section class="container mx-auto mt-4">
    <header>
      <h1 class="text-center text-3xl font-bold">{data.company.name}</h1>
    </header>
    <section>
      <header>
        <h2 class="text-2xl font-bold">Owner</h2>
      </header>
      <div>
        <span>{data.owner.name} {data.owner.surname}</span>
      </div>
    </section>
  </section>
</Layout>
